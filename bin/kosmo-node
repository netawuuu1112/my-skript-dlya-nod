#!/usr/bin/env bash
set -Eeuo pipefail
DIR=/opt/remnanode

c(){ printf '\033[1;36m%s\033[0m\n' "$*"; }
g(){ printf '\033[1;32m%s\033[0m\n' "$*"; }
y(){ printf '\033[1;33m%s\033[0m\n' "$*"; }
r(){ printf '\033[1;31m%s\033[0m\n' "$*"; }

need_root(){ [[ $EUID -eq 0 ]] || { r 'Нужен root'; exit 1; }; }
need_node(){ [[ -f "$DIR/docker-compose.yml" ]] || { r "$DIR/docker-compose.yml не найден"; exit 1; }; }

status(){
  need_node
  c '=== CONTAINERS ==='
  docker ps --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}'
  c '=== VERSIONS ==='
  docker logs remnanode 2>&1 | grep -aE 'SECRET_KEY OK|Remnawave Node v|XRay Core:' | tail -10 || true
  c '=== PORTS ==='
  ss -lntp | grep -E '(:2222|:443|:8444|:80)' || true
  c '=== UFW ==='
  ufw status || true
}

restart(){ need_root; need_node; cd "$DIR"; docker compose restart remnanode; sleep 8; status; }
logs(){ need_node; docker logs --tail="${2:-120}" -f remnanode; }

xray_bin(){
  if docker exec remnanode test -x /usr/local/bin/xray >/dev/null 2>&1; then echo '/usr/local/bin/xray';
  elif docker exec remnanode test -x /usr/bin/xray >/dev/null 2>&1; then echo '/usr/bin/xray';
  else r 'Xray binary внутри remnanode не найден'; exit 1; fi
}

keypair(){
  need_node
  local xb out priv pub sid
  xb=$(xray_bin)
  out=$(docker exec remnanode "$xb" x25519)
  priv=$(printf '%s\n' "$out" | awk -F': *' 'tolower($1) ~ /private/ {print $2; exit}')
  pub=$(printf '%s\n' "$out" | awk -F': *' 'tolower($1) ~ /(public|password)/ {print $2; exit}')
  sid=$(openssl rand -hex 8)
  [[ -n "$priv" && -n "$pub" ]] || { printf '%s\n' "$out"; r 'Не удалось распознать X25519 output'; exit 1; }
  printf '%s\n%s\n%s\n' "$priv" "$pub" "$sid"
}

keys(){
  local vals priv pub sid
  vals=$(keypair); priv=$(sed -n '1p' <<<"$vals"); pub=$(sed -n '2p' <<<"$vals"); sid=$(sed -n '3p' <<<"$vals")
  c '=== REALITY X25519 ==='
  printf 'PrivateKey: %s\nPublicKey/Password: %s\nShortID: %s\n' "$priv" "$pub" "$sid"
}

node_domain(){
  sed -nE 's/^[[:space:]]*server_name[[:space:]]+([^;_]+);.*/\1/p' "$DIR/nginx.conf" 2>/dev/null | head -n1 | xargs || true
}

profile(){
  need_root; need_node
  local mode="${2:-xhttp}" tag="${3:-}" port="${4:-}" sni="${5:-}" path="${6:-}"
  case "$mode" in xhttp|raw|both) ;; *) r 'Использование: kosmo-node profile xhttp|raw|both [TAG] [PORT] [SNI] [PATH]'; exit 1;; esac

  local domain vals priv pub sid outdir outfile xport rport
  domain=$(node_domain)
  [[ -n "$domain" ]] || { r 'Не удалось определить домен из /opt/remnanode/nginx.conf'; exit 1; }
  vals=$(keypair); priv=$(sed -n '1p' <<<"$vals"); pub=$(sed -n '2p' <<<"$vals"); sid=$(sed -n '3p' <<<"$vals")
  path=${path:-/$(openssl rand -hex 8)}; [[ "$path" == /* ]] || path="/$path"
  outdir="$DIR/generated-profiles"; mkdir -p "$outdir"

  if [[ "$mode" == xhttp ]]; then
    tag=${tag:-XHTTP-REALITY}; port=${port:-443}; sni=${sni:-$domain}; outfile="$outdir/xhttp-reality.json"
    python3 - "$outfile" "$tag" "$port" "$domain" "$sni" "$path" "$priv" "$sid" <<'PY'
import json,sys
f,tag,port,domain,sni,path,priv,sid=sys.argv[1:]
obj={"log":{"loglevel":"warning"},"dns":{"servers":["1.1.1.1","8.8.8.8"],"queryStrategy":"UseIPv4"},"inbounds":[{"tag":tag,"listen":"0.0.0.0","port":int(port),"protocol":"vless","settings":{"clients":[],"decryption":"none"},"sniffing":{"enabled":True,"routeOnly":True,"destOverride":["http","tls","quic"]},"streamSettings":{"network":"xhttp","security":"reality","xhttpSettings":{"host":domain,"mode":"auto","path":path},"realitySettings":{"dest":"/dev/shm/nginx.sock","show":False,"xver":1,"spiderX":"","shortIds":[sid],"privateKey":priv,"serverNames":[sni],"maxTimeDiff":0,"minClientVer":"1.8.0","maxClientVer":""}}}],"outbounds":[{"tag":"DIRECT","protocol":"freedom","settings":{"domainStrategy":"UseIPv4"}},{"tag":"BLOCK","protocol":"blackhole"}],"routing":{"rules":[],"domainStrategy":"IPIfNonMatch"}}
open(f,'w').write(json.dumps(obj,ensure_ascii=False,indent=2)+"\n")
PY
    ufw allow "$port"/tcp comment 'Kosmo XHTTP Reality' >/dev/null 2>&1 || true
    c '=== XHTTP + REALITY ==='
    printf 'Config Profile: %s\nAddress: %s\nPort: %s\nNetwork: xhttp\nSecurity: reality\nSNI: %s\nFingerprint: qq\nPath: %s\nMode: auto\nFlow: <empty>\nPublicKey/Password: %s\nShortID: %s\n' "$outfile" "$domain" "$port" "$sni" "$path" "$pub" "$sid"

  elif [[ "$mode" == raw ]]; then
    tag=${tag:-RAW-REALITY}; port=${port:-443}; sni=${sni:-max.ru}; outfile="$outdir/raw-reality.json"
    python3 - "$outfile" "$tag" "$port" "$sni" "$priv" "$sid" <<'PY'
import json,sys
f,tag,port,sni,priv,sid=sys.argv[1:]
obj={"log":{"loglevel":"warning"},"dns":{"servers":["1.1.1.1","8.8.8.8"],"queryStrategy":"UseIPv4"},"inbounds":[{"tag":tag,"listen":"0.0.0.0","port":int(port),"protocol":"vless","settings":{"clients":[],"flow":"xtls-rprx-vision","decryption":"none"},"sniffing":{"enabled":True,"routeOnly":True,"destOverride":["http","tls","quic"]},"streamSettings":{"network":"raw","security":"reality","realitySettings":{"dest":sni+":443","show":False,"xver":0,"spiderX":"","shortIds":[sid],"privateKey":priv,"serverNames":[sni],"maxTimeDiff":0,"minClientVer":"1.8.0","maxClientVer":""}}}],"outbounds":[{"tag":"DIRECT","protocol":"freedom","settings":{"domainStrategy":"UseIPv4"}},{"tag":"BLOCK","protocol":"blackhole"}],"routing":{"rules":[],"domainStrategy":"IPIfNonMatch"}}
open(f,'w').write(json.dumps(obj,ensure_ascii=False,indent=2)+"\n")
PY
    ufw allow "$port"/tcp comment 'Kosmo RAW Reality' >/dev/null 2>&1 || true
    c '=== RAW + REALITY + VISION ==='
    printf 'Config Profile: %s\nAddress: %s\nPort: %s\nNetwork: raw\nSecurity: reality\nSNI: %s\nFingerprint: qq\nFlow: xtls-rprx-vision\nPublicKey/Password: %s\nShortID: %s\n' "$outfile" "$domain" "$port" "$sni" "$pub" "$sid"

  else
    xport=${port:-443}; rport=8444; tag=${tag:-KOSMO}; sni=${sni:-$domain}; outfile="$outdir/xhttp-raw-reality.json"
    local vals2 priv2 pub2 sid2
    vals2=$(keypair); priv2=$(sed -n '1p' <<<"$vals2"); pub2=$(sed -n '2p' <<<"$vals2"); sid2=$(sed -n '3p' <<<"$vals2")
    python3 - "$outfile" "$tag" "$xport" "$rport" "$domain" "$sni" "$path" "$priv" "$sid" "$priv2" "$sid2" <<'PY'
import json,sys
f,tag,xp,rp,domain,sni,path,p1,s1,p2,s2=sys.argv[1:]
common={"sniffing":{"enabled":True,"routeOnly":True,"destOverride":["http","tls","quic"]}}
x={"tag":tag+"-XHTTP","listen":"0.0.0.0","port":int(xp),"protocol":"vless","settings":{"clients":[],"decryption":"none"},**common,"streamSettings":{"network":"xhttp","security":"reality","xhttpSettings":{"host":domain,"mode":"auto","path":path},"realitySettings":{"dest":"/dev/shm/nginx.sock","show":False,"xver":1,"spiderX":"","shortIds":[s1],"privateKey":p1,"serverNames":[sni],"maxTimeDiff":0,"minClientVer":"1.8.0","maxClientVer":""}}}
r={"tag":tag+"-RAW","listen":"0.0.0.0","port":int(rp),"protocol":"vless","settings":{"clients":[],"flow":"xtls-rprx-vision","decryption":"none"},**common,"streamSettings":{"network":"raw","security":"reality","realitySettings":{"dest":"max.ru:443","show":False,"xver":0,"spiderX":"","shortIds":[s2],"privateKey":p2,"serverNames":["max.ru"],"maxTimeDiff":0,"minClientVer":"1.8.0","maxClientVer":""}}}
obj={"log":{"loglevel":"warning"},"dns":{"servers":["1.1.1.1","8.8.8.8"],"queryStrategy":"UseIPv4"},"inbounds":[x,r],"outbounds":[{"tag":"DIRECT","protocol":"freedom","settings":{"domainStrategy":"UseIPv4"}},{"tag":"BLOCK","protocol":"blackhole"}],"routing":{"rules":[],"domainStrategy":"IPIfNonMatch"}}
open(f,'w').write(json.dumps(obj,ensure_ascii=False,indent=2)+"\n")
PY
    ufw allow "$xport"/tcp comment 'Kosmo XHTTP Reality' >/dev/null 2>&1 || true
    ufw allow "$rport"/tcp comment 'Kosmo RAW Reality' >/dev/null 2>&1 || true
    c '=== DUAL PROFILE ==='
    printf 'Config Profile: %s\n\nXHTTP Host: %s:%s | SNI=%s | fp=qq | path=%s | mode=auto | flow=<empty> | pbk=%s | sid=%s\nRAW Host:   %s:%s | SNI=max.ru | fp=qq | flow=xtls-rprx-vision | pbk=%s | sid=%s\n' "$outfile" "$domain" "$xport" "$sni" "$path" "$pub" "$sid" "$domain" "$rport" "$pub2" "$sid2"
  fi
  ufw reload >/dev/null 2>&1 || true
  g 'Готово. JSON вставь в Config Profile Remnawave, затем создай Host(ы) по напечатанным параметрам.'
}

update(){ need_root; need_node; cd "$DIR"; cp docker-compose.yml "docker-compose.yml.backup-update-$(date +%F-%H%M%S)"; c '=== PULL ==='; docker compose pull; c '=== RECREATE ==='; docker compose up -d --remove-orphans --force-recreate; sleep 10; status; }

doctor(){
  need_root; need_node
  c '=== HOST ==='; printf 'Public IPv4: '; curl -4fsS --connect-timeout 5 --max-time 10 https://api.ipify.org || true; echo; printf 'Kernel: '; uname -r; printf 'OS: '; . /etc/os-release; echo "${PRETTY_NAME:-unknown}"
  c '=== COMPOSE ==='; cd "$DIR"; docker compose config >/dev/null && g 'compose: OK' || r 'compose: INVALID'; grep -nE 'image:|NODE_PORT=' docker-compose.yml || true
  c '=== NODE ENV ==='; docker inspect remnanode --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null | grep -E 'NODE_PORT=|SECRET_KEY=' | sed -E 's#(SECRET_KEY=).*#\1***HIDDEN***#' || true
  c '=== VERSIONS / SECRET ==='; docker logs remnanode 2>&1 | grep -aE 'SECRET_KEY|Remnawave Node v|XRay Core:' | tail -20 || true
  c '=== PORTS ==='; ss -lntp | grep -E '(:2222|:443|:8444|:80)' || true
  c '=== FIREWALL ==='; ufw status || true
  c '=== ROUTING ==='; ip route; ip rule
  c '=== NFT REMNANODE ==='; nft list table ip remnanode 2>/dev/null || y 'remnanode nft table отсутствует/ещё не создана'
  c '=== RECENT NODE LOGS ==='; docker logs --tail=100 remnanode 2>&1 || true
  y '2222=rw-node обязателен. 443/8444=rw-core появляются после передачи соответствующего Xray config из панели.'
  y 'Проверка прихода панели: timeout 20 tcpdump -ni any tcp port 2222'
}

case "${1:-}" in
  status) status ;;
  restart) restart ;;
  logs) logs "$@" ;;
  keys) keys ;;
  profile) profile "$@" ;;
  update) update ;;
  doctor) doctor ;;
  *) cat <<USAGE
Kosmo Node helper
  kosmo-node status
  kosmo-node restart
  kosmo-node logs [N]
  kosmo-node keys
  kosmo-node profile xhttp [TAG] [PORT] [SNI] [PATH]
  kosmo-node profile raw   [TAG] [PORT] [SNI]
  kosmo-node profile both  [TAG] [XHTTP_PORT] [XHTTP_SNI] [PATH]
  kosmo-node update
  kosmo-node doctor
USAGE
  ;;
esac
